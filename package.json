{
  "name": "ext-direct-file-copy",
  "displayName": "Copy as File Object",
  "description": "Copy selected files or folders directly as native clipboard file objects to paste into Finder, File Explorer, Slack, etc.",
  "version": "1.1.1",
  "publisher": "mjkimr",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mjkimR/direct-file-copy.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "clipboard",
    "copy",
    "copy file",
    "file object",
    "native clipboard",
    "file explorer",
    "file manager",
    "zip",
    "archive",
    "pasteboard",
    "wsl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copy-file-object.copy",
        "title": "Copy as File Object",
        "category": "Direct File Copy"
      },
      {
        "command": "copy-file-object.copyAllChanges",
        "title": "Copy All Changes as File Objects",
        "category": "Direct File Copy"
      },
      {
        "command": "copy-file-object.copyAsZip",
        "title": "Copy as ZIP File Object",
        "category": "Direct File Copy"
      },
      {
        "command": "copy-file-object.diagnose",
        "title": "Diagnose Setup",
        "category": "Direct File Copy"
      }
    ],
    "keybindings": [
      {
        "command": "copy-file-object.copy",
        "key": "alt+c",
        "mac": "ctrl+c",
        "when": "filesExplorerFocus",
        "args": {
          "invocationSource": "explorer"
        }
      },
      {
        "command": "copy-file-object.copy",
        "key": "alt+c",
        "mac": "ctrl+c",
        "when": "editorTextFocus",
        "args": {
          "invocationSource": "editor"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "copy-file-object.copyAllChanges",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "copy-file-object.copy",
          "group": "5_cutcopypaste@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "copy-file-object.copyAsZip",
          "group": "5_cutcopypaste@2",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "copy-file-object.copy",
          "group": "5_cutcopypaste@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "copy-file-object.copyAsZip",
          "group": "5_cutcopypaste@2",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "command": "copy-file-object.copy",
          "group": "1_close",
          "when": "resourceScheme == file"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "copy-file-object.copy",
          "group": "1_modification@100",
          "when": "resourceScheme == file"
        },
        {
          "command": "copy-file-object.copyAsZip",
          "group": "1_modification@101",
          "when": "resourceScheme == file"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "copy-file-object.copyAllChanges",
          "group": "1_modification@100"
        }
      ]
    },
    "configuration": {
      "title": "Direct File Copy",
      "properties": {
        "directFileCopy.notificationStyle": {
          "type": "string",
          "enum": [
            "popup",
            "statusBar"
          ],
          "enumDescriptions": [
            "Show an information popup notification after copying.",
            "Show a transient status bar message (auto-dismisses after 3 seconds)."
          ],
          "default": "statusBar",
          "description": "How to confirm a successful copy."
        },
        "directFileCopy.saveBeforeCopy": {
          "type": "string",
          "enum": [
            "prompt",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask whether to save selected files that have unsaved changes before copying.",
            "Always save selected files that have unsaved changes before copying.",
            "Never save automatically; copy the last saved version from disk."
          ],
          "default": "prompt",
          "description": "How to handle selected files with unsaved changes before copying."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "npm run test:unit",
    "test:unit": "node --test \"out/test/unit/*.test.js\"",
    "test:clipboard": "node --test \"out/test/integration/*.test.js\"",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^18.11.18",
    "@types/vscode": "1.75.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.39.4",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "yazl": "^3.3.1"
  }
}